  "sample_queries": [
    {
      "title": "Resolve one complaint's full entity chain",
      "sql": "SELECT c.complaint_id, a.account_id, a.account_type, t.to_account_id, t.amount_inr\nFROM Complaint c\nJOIN ComplaintAccount ca ON ca.complaint_id = c.complaint_id\nJOIN Account a ON a.account_id = ca.account_id\nJOIN \"Transaction\" t ON t.from_account_id = a.account_id\nWHERE c.complaint_id = 'CF-1042'\nLIMIT 8;",
      "columns": [
        "complaint_id",
        "account_id",
        "account_type",
        "to_account_id",
        "amount_inr"
      ],
