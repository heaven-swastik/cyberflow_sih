      "title": "Rank predicted ATMs with supporting evidence",
      "sql": "SELECT p.complaint_id, p.predicted_atm_id, p.confidence, pf.feature_name\nFROM Prediction p\nJOIN PredictionFeature pf ON pf.prediction_id = p.prediction_id\nORDER BY p.complaint_id, pf.rank_order\nLIMIT 8;",
      "columns": [
        "complaint_id",
        "predicted_atm_id",
        "confidence",
        "feature_name"
