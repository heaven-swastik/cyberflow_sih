# Copy to .env and replace placeholders locally. Never commit .env.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_NAME=CyberFlow Administrator
AUTH_USERS_FILE=./users.json
CYBERFLOW_API_KEY=replace-with-a-random-api-key
CORS_ORIGIN=http://localhost:5173
PORT=5000

# Gmail app password and recipient stay on the backend only.
SMTP_USER=your-sender@gmail.com
SMTP_APP_PASSWORD=replace-with-gmail-app-password
ALERT_RECIPIENT=investigator@example.com
APP_URL=http://localhost:5173
